page {
  background: var(--theme-background);
}

.page {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  background: var(--theme-background);
}


/* 顶部 */

.header {
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--theme-text);
}

.header-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--theme-muted);
}


/* 视图切换 */

.view-tabs {
  margin-top: 20rpx;
  padding: 8rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 25rpx;
  color: #665d75;
  border-radius: 18rpx;
}

.view-tab.active {
  background: linear-gradient(135deg, #765B91, #9180A8);
  color: #ffffff;
  font-weight: 600;
}


/* 更多选项 */

.more-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
  padding: 8rpx 0;
  font-size: 23rpx;
  color: var(--theme-main);
  font-weight: 600;
}

.more-arrow {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: var(--theme-main);
}


/* 日期 */

.date-card {
  margin-top: 20rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 28rpx;
}

.date-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #393449;
}

.date-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9993a5;
}


/* 添加区域 */

.add-card {
  margin-top: 28rpx;
  width: 100%;
  height: 82rpx;
  padding: 10rpx 12rpx 10rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.todo-input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  font-size: 26rpx;
  color: #393449;
}

.add-button {
  width: 50rpx !important;
  height: 50rpx !important;
  min-width: 50rpx !important;
  max-width: 50rpx !important;
  min-height: 50rpx !important;
  max-height: 50rpx !important;
  flex: none;
  flex-shrink: 0;
  margin: 0 !important;
  padding: 0 !important;

  background: linear-gradient(
    135deg,
    #765B91 0%,
    #806A9A 52%,
    #9180A8 100%
  ) !important;

  color: #ffffff !important;
  border-radius: 50% !important;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 48rpx;
  text-align: center;
}

.add-button::after {
  display: none;
  border: none;
}


/* 添加选项：优先级 + 截止日期 */

.add-options {
  margin-top: 16rpx;
  display: flex;
}

.option {
  flex: 1;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}

.option + .option {
  margin-left: 16rpx;
}

.option-inner {
  flex: 1;
  display: flex;
  align-items: center;
}

.option-label {
  font-size: 24rpx;
  color: #9993a5;
}

.option-value {
  flex: 1;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #9993a5;
}

.option-value.has-value {
  color: #765B91;
  font-weight: 600;
}

.option-arrow {
  font-size: 28rpx;
  color: #c9c3d2;
}

.option-clear {
  margin-left: 8rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: #b0a9ba;
  background: #f0edf4;
  border-radius: 50%;
}


/* 所属项目 */

.project-row {
  margin-top: 16rpx;
}

.project-picker {
  display: block;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.project-picker-inner {
  display: flex;
  align-items: center;
}


/* 项目标签 */

.project-tag {
  background: #EDEFF8;
  color: #6E7FA8;
}


/* 优先级选择面板 */

.priority-panel {
  margin-top: 12rpx;
  padding: 12rpx;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
}

.priority-item {
  flex: 1;
  margin: 0 6rpx;
  padding: 14rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #9993a5;
  background: #f5f3f8;
  border-radius: 14rpx;
}

.priority-item.high.active {
  background: #B96B73;
  color: #ffffff;
}

.priority-item.medium.active {
  background: #C49A5A;
  color: #ffffff;
}

.priority-item.low.active {
  background: #6F9B7A;
  color: #ffffff;
}

.priority-item.clear {
  background: #f0edf4;
  color: #9993a5;
}


/* 统计 */

.summary {
  margin-top: 28rpx;
  padding: 25rpx 10rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  justify-content: space-around;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #393449;
}

.summary-number.overdue {
  color: #B96B73;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9993a5;
}


/* 待办列表 */

.todo-list {
  margin-top: 20rpx;
}

.todo-item {
  min-height: 88rpx;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--theme-border);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.todo-item:last-child {
  border-bottom: none;
}

.todo-item.overdue-item {
  border-left: 4rpx solid var(--theme-danger);
  padding-left: 16rpx;
}


/* 完成按钮 */

.todo-check {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  margin-right: 20rpx;
  border: 3rpx solid #d9d3e5;
  border-radius: 50%;
  box-sizing: border-box;
}

.todo-check.active {
  background: linear-gradient(135deg, #765B91, #9180A8);
  border-color: #765B91;
}


/* 待办主体 */

.todo-main {
  flex: 1;
  min-width: 0;
}

.todo-text {
  font-size: 27rpx;
  color: #393449;
  line-height: 1.5;
  word-break: break-all;
}

.todo-text.completed {
  color: #aaa5b2;
  text-decoration: line-through;
}

.todo-date {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #9993a5;
}

.todo-meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  margin-right: 12rpx;
  margin-bottom: 4rpx;
  padding: 4rpx 14rpx;
  font-size: 21rpx;
  border-radius: 999rpx;
}


/* 优先级标签 */

.priority-tag.priority-high {
  background: #F7ECEE;
  color: #B96B73;
}

.priority-tag.priority-medium {
  background: #F8F1E5;
  color: #B98A4E;
}

.priority-tag.priority-low {
  background: #EAF1EC;
  color: #5E8668;
}


/* 截止日期标签 */

.deadline-tag {
  background: #EEE9F4;
  color: #765B91;
}

.deadline-tag.overdue {
  background: #F7ECEE;
  color: #B96B73;
}


/* 逾期标签 */

.overdue-tag {
  background: #B96B73;
  color: #ffffff;
}


/* 删除 */

.delete {
  flex: none;
  margin-left: 15rpx;
  font-size: 23rpx;
  color: #aaa3b2;
}


/* 空状态 */

.empty {
  margin-top: 70rpx;
  text-align: center;
}

.empty-icon {
  width: 90rpx;
  height: 90rpx;
  margin: 0 auto 25rpx;
  border-radius: 50%;
  background: #EEE9F4;
  color: #765B91;
  font-size: 50rpx;
  line-height: 85rpx;
  text-align: center;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #393449;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #aaa3b2;
}


/* =====================================================
   模式 1
   ===================================================== */

.page.theme-1 {
  background: #F7F5FA;
}

.theme-1 .add-button {
  background: linear-gradient(135deg, #765B91 0%, #806A9A 52%, #9180A8 100%) !important;
}

.theme-1 .todo-check.active {
  background: linear-gradient(135deg, #765B91, #9180A8);
  border-color: #765B91;
}

.theme-1 .empty-icon {
  background: #EEE9F4;
  color: #765B91;
}

.theme-1 .option-value.has-value {
  color: #765B91;
}

.theme-1 .deadline-tag {
  background: #EEE9F4;
  color: #765B91;
}


/* =====================================================
   模式 2
   ===================================================== */

.page.theme-2 {
  background: #F6F7FB;
}

.theme-2 .add-button {
  background: linear-gradient(135deg, #7D86C9 0%, #8885C4 52%, #9A8FC7 100%) !important;
}

.theme-2 .todo-check.active {
  background: linear-gradient(135deg, #7D86C9, #9A8FC7);
  border-color: #7D86C9;
}

.theme-2 .empty-icon {
  background: #EEF0FA;
  color: #7D86C9;
}

.theme-2 .option-value.has-value {
  color: #7D86C9;
}

.theme-2 .deadline-tag {
  background: #EEF0FA;
  color: #7D86C9;
}


/* =====================================================
   搜索框
   ===================================================== */

.search-card {
  margin-top: 20rpx;
  height: 82rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  font-size: 26rpx;
  color: #393449;
}


/* =====================================================
   筛选 / 排序栏
   ===================================================== */

.filter-bar {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.filter-btn {
  padding: 12rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  font-size: 23rpx;
  color: #765B91;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(50, 38, 70, 0.05);
}

.sort-btn {
  margin-left: 16rpx;
  padding: 12rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  font-size: 23rpx;
  color: #7F7789;
  box-shadow: 0 6rpx 20rpx rgba(50, 38, 70, 0.05);
}

.filter-count {
  margin-left: auto;
  font-size: 23rpx;
  color: #9993A5;
}


/* =====================================================
   筛选面板
   ===================================================== */

.filter-panel {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(50, 38, 70, 0.05);
}

.filter-group {
  margin-bottom: 24rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-group-title {
  font-size: 23rpx;
  color: #9993A5;
  margin-bottom: 14rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.filter-option {
  margin-right: 14rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 24rpx;
  background: #F5F3F8;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #665d75;
}

.filter-option.active {
  background: #765B91;
  color: #ffffff;
}

.theme-2 .filter-btn {
  color: #7D86C9;
}

.theme-2 .filter-option.active {
  background: #7D86C9;
}

.theme-2 .view-tab.active {
  background: linear-gradient(135deg, #7D86C9, #9A8FC7);
}


/* =====================================================
   新建任务 · 描述 / 标签
   ===================================================== */

.desc-card {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.desc-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: #393449;
  box-sizing: border-box;
}

.tags-card {
  margin-top: 16rpx;
  height: 82rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.tags-input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  font-size: 26rpx;
  color: #393449;
}
