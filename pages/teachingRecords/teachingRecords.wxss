page {
  background: var(--theme-background);
}


/* =====================================================
   页面
===================================================== */

.page {
  min-height: 100vh;

  /*
   * 顶部增加留白
   * 让“本月课程”卡片不要紧贴系统导航栏
   */
  padding: 48rpx 30rpx 80rpx;

  box-sizing: border-box;

  background: var(--theme-background);
}


/* =====================================================
   周期卡片
===================================================== */

.period-card {
  display: flex;

  align-items: center;

  padding: 24rpx;

  background: #FFFFFF;

  border-radius: 24rpx;

  box-shadow:
    0 10rpx 30rpx rgba(90, 70, 110, 0.06);

  /*
   * 与搜索框保持舒服的距离
   */
  margin-bottom: 22rpx;
}


.period-icon {
  width: 70rpx;

  height: 70rpx;

  flex-shrink: 0;

  border-radius: 22rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #EEE9F4;

  color: #765B91;

  font-size: 26rpx;

  font-weight: 700;
}


.period-info {
  margin-left: 18rpx;

  min-width: 0;
}


.period-title {
  font-size: 28rpx;

  font-weight: 700;

  color: #3E3945;
}


.period-desc {
  margin-top: 6rpx;

  font-size: 20rpx;

  color: #A39BA8;
}


/* =====================================================
   搜索
===================================================== */

.search-card {
  height: 76rpx;

  display: flex;

  align-items: center;

  padding: 0 22rpx;

  box-sizing: border-box;

  background: #FFFFFF;

  border-radius: 20rpx;

  margin-bottom: 24rpx;

  box-shadow:
    0 8rpx 24rpx rgba(90, 70, 110, 0.05);
}


.search-icon {
  width: 42rpx;

  flex-shrink: 0;

  color: #765B91;

  font-size: 22rpx;

  font-weight: 700;
}


.search-input {
  flex: 1;

  min-width: 0;

  height: 76rpx;

  font-size: 24rpx;

  color: #3E3945;
}


.clear-button {
  width: 42rpx;

  height: 42rpx;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  color: #A9A1AD;

  font-size: 34rpx;
}


/* =====================================================
   课程卡片
===================================================== */

.course-card {
  background: #FFFFFF;

  border-radius: 26rpx;

  padding: 26rpx;

  margin-bottom: 22rpx;

  box-sizing: border-box;

  box-shadow:
    0 10rpx 32rpx rgba(90, 70, 110, 0.06);
}


/* =====================================================
   第一行
===================================================== */

.course-top {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;
}


.date-area {
  flex: 1;

  min-width: 0;
}


.date-day {
  font-size: 28rpx;

  font-weight: 700;

  color: #3E3945;
}


.course-time {
  margin-top: 8rpx;

  font-size: 21rpx;

  color: #A39BA8;
}


.status-tag {
  flex-shrink: 0;

  margin-left: 18rpx;

  padding: 8rpx 16rpx;

  border-radius: 30rpx;

  font-size: 19rpx;

  font-weight: 600;
}


/* =====================================================
   状态
===================================================== */

.status-finished {
  background: #EEE9F4;

  color: #765B91;
}


.status-running {
  background: #EDEAF7;

  color: #675A9B;
}


.status-pending {
  background: #F5F1F7;

  color: #9A8FA1;
}


.status-leave {
  background: #F4EEF3;

  color: #A26B88;
}


.status-cancelled {
  background: #F1F1F1;

  color: #999999;
}


/* =====================================================
   学生
===================================================== */

.student-row {
  display: flex;

  align-items: center;

  margin-top: 24rpx;

  padding-top: 22rpx;

  border-top: 1rpx solid #F0EDF2;
}


.student-avatar {
  width: 64rpx;

  height: 64rpx;

  flex-shrink: 0;

  border-radius: 20rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #EEE9F4;

  color: #765B91;

  font-size: 25rpx;

  font-weight: 700;
}


.student-info {
  margin-left: 16rpx;

  min-width: 0;
}


.student-name {
  font-size: 27rpx;

  font-weight: 700;

  color: #3E3945;

  line-height: 36rpx;
}


/*
 * 年级 · 化学
 *
 * 关键：
 * display:flex
 * flex-direction:row
 *
 * 保证三个内容永远在同一行
 */

.student-meta {
  display: flex;

  flex-direction: row;

  align-items: center;

  margin-top: 3rpx;

  font-size: 20rpx;

  line-height: 20rpx;

  color: #A39BA8;

  white-space: nowrap;
}


.student-grade {
  display: inline-block;

  white-space: nowrap;
}


.student-dot {
  display: inline-block;

  margin: 0 7rpx;

  color: #C2BAC7;
}


.student-subject {
  display: inline-block;

  white-space: nowrap;
}


/* =====================================================
   课程内容
===================================================== */

.topic-box {
  margin-top: 20rpx;

  padding: 20rpx;

  border-radius: 20rpx;

  background: #F7F4F9;
}


.box-label {
  font-size: 19rpx;

  font-weight: 600;

  color: #A39BA8;
}


.topic-text {
  margin-top: 8rpx;

  font-size: 24rpx;

  line-height: 1.6;

  color: #514A57;
}


.topic-empty {
  margin-top: 20rpx;

  font-size: 21rpx;

  color: #B0A8B4;
}


/* =====================================================
   底部
===================================================== */

.course-footer {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-top: 22rpx;

  padding-top: 20rpx;

  border-top: 1rpx solid #F0EDF2;
}


.footer-text {
  font-size: 21rpx;

  color: #765B91;

  font-weight: 600;
}


.footer-arrow {
  font-size: 32rpx;

  color: #B0A7B5;
}


/* =====================================================
   空状态
===================================================== */

.empty-card {
  margin-top: 30rpx;

  padding: 60rpx 30rpx;

  background: #FFFFFF;

  border-radius: 26rpx;

  text-align: center;

  box-shadow:
    0 10rpx 32rpx rgba(90, 70, 110, 0.05);
}


.empty-icon {
  width: 80rpx;

  height: 80rpx;

  margin: 0 auto 22rpx;

  border-radius: 26rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #EEE9F4;

  color: #765B91;

  font-size: 28rpx;

  font-weight: 700;
}


.empty-title {
  font-size: 28rpx;

  font-weight: 700;

  color: #4A4350;
}


.empty-text {
  margin-top: 12rpx;

  font-size: 21rpx;

  line-height: 1.6;

  color: #AAA2AE;
}


.empty-button {
  display: inline-flex;

  margin-top: 24rpx;

  padding: 12rpx 26rpx;

  border-radius: 30rpx;

  background: #EEE9F4;

  color: #765B91;

  font-size: 21rpx;

  font-weight: 600;
}


/* =====================================================
   底部提示
===================================================== */

.bottom-tip {
  padding: 18rpx 0 30rpx;

  text-align: center;

  font-size: 19rpx;

  color: #B0A8B4;
}


/* =====================================================
   模式2
===================================================== */

.theme-2 .period-icon {
  background: #EEF0FA;

  color: #7D86C9;
}


.theme-2 .search-icon {
  color: #7D86C9;
}


.theme-2 .status-finished,
.theme-2 .status-running {
  background: #EEF0FA;

  color: #7D86C9;
}


.theme-2 .student-avatar {
  background: #EEF0FA;

  color: #7D86C9;
}


.theme-2 .footer-text {
  color: #7D86C9;
}


.theme-2 .empty-icon {
  background: #EEF0FA;

  color: #7D86C9;
}


.theme-2 .empty-button {
  background: #EEF0FA;

  color: #7D86C9;
}