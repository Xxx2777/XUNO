page {
  background: var(--theme-background);
}


/* 页面 */

.page {
  min-height: 100vh;
  padding: 30rpx 30rpx 80rpx;
  box-sizing: border-box;
}


/* 顶部 */

.top {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  line-height: 52rpx;
  color: #30283c;
  box-shadow: 0 6rpx 20rpx rgba(50, 38, 70, 0.05);
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #30283c;
}

.placeholder {
  width: 70rpx;
}


/* 欢迎 */

.welcome-card {
  margin-top: 25rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #eee8fa;
}

.welcome-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #40384b;
}

.welcome-text {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #82788f;
}


/* 所属项目 */

.project-select-card {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(50, 38, 70, 0.05);
}

.project-picker-inner {
  display: flex;
  align-items: center;
}

.project-label {
  font-size: 24rpx;
  color: #82788f;
}

.project-value {
  flex: 1;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #82788f;
}

.project-value.has-value {
  color: #765B91;
  font-weight: 600;
}

.project-arrow {
  font-size: 28rpx;
  color: #c9c3d2;
}


/* 学习目标标题 */

.section-title {
  margin-top: 30rpx;
  margin-bottom: 15rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #352d41;
}


/* 学习卡片 */

.study-card {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(50, 38, 70, 0.05);
}


/* 卡片头部 */

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #352d41;
}

.card-symbol {
  margin-right: 8rpx;
}

.card-desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9991a2;
}

.percent {
  min-width: 80rpx;
  height: 55rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #eee8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-main);
  font-size: 22rpx;
  font-weight: 700;
}


/* 进度 */

.progress-box {
  width: 100%;
  margin-top: 26rpx;
}

.progress-bg {
  width: 100%;
  height: 16rpx;
  border-radius: 20rpx;
  background: #eeeaf4;
  overflow: hidden;
}

.progress-inner {
  height: 16rpx;
  border-radius: 20rpx;
  background: var(--theme-main);
  transition: width 0.35s ease;
  min-width: 0;
  max-width: 100%;
}

.progress-info {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18rpx;
  color: #aaa2b0;
}


/* 输入 */

.input-row {
  margin-top: 23rpx;
  padding: 9rpx;
  border-radius: 20rpx;
  background: #f7f4fb;
  display: flex;
  align-items: center;
}

.study-input {
  flex: 1;
  height: 68rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  font-size: 23rpx;
  color: #40384b;
}

.record-button {
  width: 120rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 18rpx;
  background: var(--theme-main);
  color: #ffffff;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-button::after {
  border: none;
}


/* 学习内容输入 */

.content-row {
  margin-top: 16rpx;
  padding: 9rpx;
  border-radius: 20rpx;
  background: #f7f4fb;
}

.content-input {
  width: 100%;
  height: 68rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  font-size: 23rpx;
  color: #40384b;
}


/* 修改目标 */

.target-setting {
  margin-top: 18rpx;
  padding: 12rpx 4rpx 2rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--theme-main);
  font-size: 20rpx;
}

.setting-arrow {
  font-size: 30rpx;
  color: #aaa2b0;
}


/* 删除自定义目标 */

.delete-target {
  margin-top: 15rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0edf4;
  text-align: right;
  font-size: 19rpx;
  color: #b1aab8;
}


/* 添加学习目标 */

.add-target-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 26rpx rgba(50, 38, 70, 0.05);
}

.add-target-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 21rpx;
  background: #eee8fa;
  color: var(--theme-main);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 400;
}

.add-target-content {
  flex: 1;
  margin-left: 20rpx;
}

.add-target-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #352d41;
}

.add-target-desc {
  margin-top: 7rpx;
  font-size: 20rpx;
  color: #9991a2;
}

.add-target-arrow {
  margin-left: 15rpx;
  font-size: 32rpx;
  color: #aaa2b0;
}


/* 今日总结 */

.summary-card {
  margin-top: 20rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(50, 38, 70, 0.05);
}

.summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #352d41;
}

.summary-text {
  margin-top: 7rpx;
  font-size: 20rpx;
  color: #9991a2;
}

.summary-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-number {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--theme-main);
}

.summary-label {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #9991a2;
}

.summary-line {
  width: 2rpx;
  height: 55rpx;
  background: #eee9f5;
}


/* 提醒 */

.tip-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #eee8fa;
  display: flex;
  align-items: center;
}

.tip-icon {
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
  margin-right: 15rpx;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-main);
  font-size: 22rpx;
  font-weight: 700;
}

.tip-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--theme-main);
}

.tip-text {
  margin-top: 5rpx;
  font-size: 18rpx;
  color: #756d80;
}


/* 底部 */

.bottom-text {
  margin-top: 35rpx;
  text-align: center;
  color: #aaa2b0;
  font-size: 18rpx;
}


/* =====================================================
   模式1
   严格按照首页主题
===================================================== */

.page.theme-1 {
  background: var(--theme-background);
}

.theme-1 .welcome-card {
  background: #EEE9F4;
}

.theme-1 .percent {
  background: #EEE9F4;
  color: #765B91;
}

.theme-1 .progress-inner {
  background: linear-gradient(
    135deg,
    #765B91 0%,
    #806A9A 52%,
    #9180A8 100%
  );
}

.theme-1 .input-row,
.theme-1 .content-row {
  background: var(--theme-background);
}

.theme-1 .record-button {
  background: linear-gradient(
    135deg,
    #765B91 0%,
    #806A9A 52%,
    #9180A8 100%
  );
}

.theme-1 .target-setting {
  color: #765B91;
}

.theme-1 .add-target-icon {
  background: #EEE9F4;
  color: #765B91;
}

.theme-1 .summary-number {
  color: #765B91;
}

.theme-1 .tip-card {
  background: #EEE9F4;
}

.theme-1 .tip-icon {
  color: #765B91;
}

.theme-1 .tip-title {
  color: #765B91;
}


/* =====================================================
   模式2
   严格按照首页主题
===================================================== */

.page.theme-2 {
  background: #F6F7FB;
}

.theme-2 .welcome-card {
  background: #EEF0FA;
}

.theme-2 .percent {
  background: #EEF0FA;
  color: #7D86C9;
}

.theme-2 .progress-inner {
  background: linear-gradient(
    135deg,
    #7D86C9 0%,
    #8885C4 52%,
    #9A8FC7 100%
  );
}

.theme-2 .input-row,
.theme-2 .content-row {
  background: #F6F7FB;
}

.theme-2 .record-button {
  background: linear-gradient(
    135deg,
    #7D86C9 0%,
    #8885C4 52%,
    #9A8FC7 100%
  );
}

.theme-2 .target-setting {
  color: #7D86C9;
}

.theme-2 .add-target-icon {
  background: #EEF0FA;
  color: #7D86C9;
}

.theme-2 .summary-number {
  color: #7D86C9;
}

.theme-2 .tip-card {
  background: #EEF0FA;
}

.theme-2 .tip-icon {
  color: #7D86C9;
}

.theme-2 .tip-title {
  color: #7D86C9;
}


/* =====================================================
   学习计划
===================================================== */

.plan-list {
  margin-bottom: 16rpx;
}

.plan-card {
  margin-bottom: 18rpx;
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(50, 38, 70, 0.05);
}

.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #352d41;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-delete {
  flex: none;
  margin-left: 16rpx;
  font-size: 21rpx;
  color: #b1aab8;
}

.plan-dates {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--theme-main);
  font-weight: 600;
}

.plan-daily {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #9991a2;
}

.plan-progress-text {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #4a4251;
}

.plan-progress-bg {
  margin-top: 10rpx;
  height: 14rpx;
  border-radius: 20rpx;
  background: #eeeaf4;
  overflow: hidden;
}

.plan-progress-inner {
  height: 14rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #765B91, #9180A8);
}

.plan-progress-0 { width: 0%; }
.plan-progress-1 { width: 10%; }
.plan-progress-2 { width: 20%; }
.plan-progress-3 { width: 30%; }
.plan-progress-4 { width: 40%; }
.plan-progress-5 { width: 50%; }
.plan-progress-6 { width: 60%; }
.plan-progress-7 { width: 70%; }
.plan-progress-8 { width: 80%; }
.plan-progress-9 { width: 90%; }
.plan-progress-10 { width: 100%; }

.plan-nodaily {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #aaa2b0;
}

.plan-project {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--theme-main);
}

.plan-empty {
  margin-bottom: 16rpx;
  padding: 36rpx 28rpx;
  border-radius: 26rpx;
  background: #ffffff;
  text-align: center;
}

.plan-empty-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #352d41;
}

.plan-empty-desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9991a2;
}

.plan-add {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  font-size: 24rpx;
  color: var(--theme-main);
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(50, 38, 70, 0.05);
}


/* 计划编辑弹层 */

.plan-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-panel {
  width: 640rpx;
  max-height: 80vh;
  padding: 36rpx 32rpx 30rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #ffffff;
  overflow-y: auto;
}

.plan-panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #332d3a;
  margin-bottom: 22rpx;
}

.plan-field {
  margin-bottom: 20rpx;
}

.plan-field-label {
  font-size: 22rpx;
  color: #9991a2;
  margin-bottom: 10rpx;
}

.plan-field-input {
  height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f7f5fb;
  font-size: 24rpx;
  color: #40384b;
}

.plan-picker {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f7f5fb;
  font-size: 24rpx;
  color: #9991a2;
}

.plan-picker.has-value {
  color: #40384b;
}

.plan-field-textarea {
  width: 100%;
  height: 120rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f7f5fb;
  font-size: 24rpx;
  color: #40384b;
}

.plan-actions {
  margin-top: 26rpx;
  display: flex;
}

.plan-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 25rpx;
  color: #665d75;
  background: #f0edf4;
}

.plan-btn + .plan-btn {
  margin-left: 20rpx;
}

.plan-btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #765B91, #9180A8);
}


/* 主题2 · 学习计划 */

.theme-2 .plan-dates,
.theme-2 .plan-project {
  color: #7D86C9;
}

.theme-2 .plan-progress-inner {
  background: linear-gradient(135deg, #7D86C9, #9A8FC7);
}

.theme-2 .plan-add {
  color: #7D86C9;
}

.theme-2 .plan-btn-primary {
  background: linear-gradient(135deg, #7D86C9, #9A8FC7);
}


/* =====================================================
   今日学习概览
===================================================== */

.overview-card {
  margin-top: 20rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #765B91 0%, #806A9A 52%, #9180A8 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(118, 91, 145, 0.16);
}

.overview-title {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.74);
}

.overview-minutes {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
}

.overview-minutes text {
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.84;
}

.overview-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.74);
}

.overview-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.80);
}


/* 主题2 · 今日学习概览 */

.theme-2 .overview-card {
  background: linear-gradient(135deg, #7D86C9 0%, #8885C4 52%, #9A8FC7 100%);
  box-shadow: 0 12rpx 32rpx rgba(125, 134, 201, 0.16);
}


/* =====================================================
   Section 副标题
===================================================== */

.section-sub {
  margin-top: -8rpx;
  margin-bottom: 16rpx;
  font-size: 21rpx;
  color: #9991a2;
}


/* =====================================================
   学习历史入口
===================================================== */

.history-entry {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 26rpx rgba(50, 38, 70, 0.05);
}

.history-entry-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 21rpx;
  background: #eee8fa;
  color: var(--theme-main);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.history-entry-content {
  flex: 1;
  margin-left: 20rpx;
}

.history-entry-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #352d41;
}

.history-entry-desc {
  margin-top: 7rpx;
  font-size: 20rpx;
  color: #9991a2;
}

.history-entry-arrow {
  margin-left: 15rpx;
  font-size: 32rpx;
  color: #aaa2b0;
}

.theme-2 .history-entry-icon {
  background: #EEF0FA;
  color: #7D86C9;
}


/* =====================================================
   学习目标管理列表
===================================================== */

.goal-list {
  margin-bottom: 16rpx;
  border-radius: var(--radius-md);
  background: var(--theme-card);
  box-shadow: 0 6rpx 20rpx var(--theme-shadow-card);
  overflow: hidden;
}

.goal-item {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--theme-border);
}

.goal-item:last-child {
  border-bottom: none;
}

.goal-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  color: var(--theme-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-target {
  flex: none;
  margin-right: 16rpx;
  font-size: var(--font-secondary);
  color: var(--theme-subtext);
}

.goal-edit {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--theme-main-light);
  color: var(--theme-main);
  font-size: var(--font-secondary);
  font-weight: 600;
}

.goal-delete {
  flex: none;
  margin-left: 12rpx;
  padding: 8rpx 12rpx;
  font-size: var(--font-secondary);
  color: var(--theme-muted);
}