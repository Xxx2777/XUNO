/* =========================================================
   页面
========================================================= */

.page {
  min-height: 100vh;
  padding: 32rpx 30rpx 60rpx;
  box-sizing: border-box;
}


/* =========================================================
   模式1
========================================================= */

.theme-1 {

  --main: #765B91;

  --main-light: #EEE9F4;

  --main-soft: #F4F1F7;

  --background: #F7F5FA;

  --text-main: #332D3A;

  --text-secondary: #766D7E;

  --text-light: #A29AA9;

  --card: #FFFFFF;

  --border: #E7E1EC;

}


/* =========================================================
   模式2
========================================================= */

.theme-2 {

  --main: #7D86C9;

  --main-light: #EEF0FA;

  --main-soft: #F3F4F9;

  --background: #F6F7FB;

  --text-main: #332D3A;

  --text-secondary: #766D7E;

  --text-light: #A29AA9;

  --card: #FFFFFF;

  --border: #E4E6F0;

}


/* =========================================================
   顶部
========================================================= */

.header {

  display: flex;

  align-items: center;

  margin-bottom: 32rpx;

}


/* 标题区域 */

.header-info {

  flex: 1;

}

.header-title {

  color: var(--text-main);

  font-size: 40rpx;

  font-weight: 700;

  line-height: 1.4;

}

.header-desc {

  margin-top: 6rpx;

  color: var(--text-secondary);

  font-size: 24rpx;

}


/* =========================================================
   提示卡片
========================================================= */

.tip-card {

  display: flex;

  align-items: center;

  padding: 26rpx 24rpx;

  margin-bottom: 26rpx;

  background: var(--main-soft);

  border-radius: 24rpx;

  box-sizing: border-box;

}


.tip-icon {

  width: 70rpx;

  height: 70rpx;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-right: 20rpx;

  border-radius: 20rpx;

  background: var(--main);

  color: #FFFFFF;

  font-size: 28rpx;

  font-weight: 700;

}


.tip-content {

  flex: 1;

}


.tip-title {

  color: var(--text-main);

  font-size: 28rpx;

  font-weight: 600;

}


.tip-desc {

  margin-top: 6rpx;

  color: var(--text-secondary);

  font-size: 22rpx;

}


/* =========================================================
   课程列表
========================================================= */

.course-list {

  width: 100%;

}


/* =========================================================
   单个课程卡片
========================================================= */

.course-card {

  display: flex;

  align-items: center;

  width: 100%;

  padding: 24rpx;

  margin-bottom: 20rpx;

  box-sizing: border-box;

  background: var(--card);

  border-radius: 24rpx;

  border: 1rpx solid var(--border);

  box-shadow:

    0 8rpx 24rpx rgba(60, 50, 80, 0.05);

  transition: opacity 0.2s;

}

.course-card:active {

  opacity: 0.75;

}


/* =========================================================
   日期
========================================================= */

.date-box {

  width: 86rpx;

  height: 96rpx;

  flex-shrink: 0;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  margin-right: 20rpx;

  border-radius: 20rpx;

  background: var(--main-light);

}


.date-month {

  color: var(--main);

  font-size: 21rpx;

}


.date-day {

  margin-top: 2rpx;

  color: var(--main);

  font-size: 38rpx;

  font-weight: 700;

  line-height: 1;

}


/* =========================================================
   课程信息
========================================================= */

.course-info {

  flex: 1;

  min-width: 0;

}


.course-title {

  margin-top: 8rpx;

  color: var(--text-secondary);

  font-size: 23rpx;

  font-weight: 400;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

}


.course-student {

  color: var(--text-main);

  font-size: 27rpx;

  font-weight: 700;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

}


.separator {

  margin: 0 8rpx;

  color: var(--text-light);

}


.course-time {

  margin-top: 7rpx;

  color: var(--text-light);

  font-size: 21rpx;

}


/* =========================================================
   右侧
========================================================= */

.course-right {

  display: flex;

  align-items: center;

  margin-left: 14rpx;

}


.status {

  padding: 7rpx 12rpx;

  border-radius: 12rpx;

  background: var(--main-light);

  color: var(--main);

  font-size: 20rpx;

  white-space: nowrap;

}


.arrow {

  margin-left: 10rpx;

  color: var(--text-light);

  font-size: 38rpx;

  line-height: 1;

}


/* =========================================================
   空状态
========================================================= */

.empty-card {

  display: flex;

  flex-direction: column;

  align-items: center;

  padding: 90rpx 40rpx;

  margin-top: 30rpx;

  background: var(--card);

  border-radius: 28rpx;

  border: 1rpx solid var(--border);

  box-sizing: border-box;

}


.empty-icon {

  width: 100rpx;

  height: 100rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 24rpx;

  border-radius: 50%;

  background: var(--main-light);

  color: var(--main);

  font-size: 44rpx;

  font-weight: 700;

}


.empty-title {

  color: var(--text-main);

  font-size: 30rpx;

  font-weight: 600;

}


.empty-desc {

  margin-top: 12rpx;

  color: var(--text-secondary);

  font-size: 23rpx;

  text-align: center;

}