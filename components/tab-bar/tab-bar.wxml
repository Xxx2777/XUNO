<view class="tabbar {{themeClass}}">

  <view
    class="tab-item {{active === 'today' ? 'active' : ''}}"
    bindtap="goToday"
  >
    <view class="tab-icon icon icon-home"></view>
    <view class="tab-text">Today</view>
  </view>

  <view
    class="tab-item {{active === 'calendar' ? 'active' : ''}}"
    bindtap="goCalendar"
  >
    <view class="tab-icon icon icon-calendar"></view>
    <view class="tab-text">Calendar</view>
  </view>

  <view
    class="tab-item {{active === 'statistics' ? 'active' : ''}}"
    bindtap="goStatistics"
  >
    <view class="tab-icon icon icon-chart"></view>
    <view class="tab-text">Insights</view>
  </view>

  <view
    class="tab-item {{active === 'mine' ? 'active' : ''}}"
    bindtap="goMine"
  >
    <view class="tab-icon icon icon-user"></view>
    <view class="tab-text">Workspace</view>
  </view>

</view>
