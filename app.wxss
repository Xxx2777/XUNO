/* =====================================================
   全局基础
===================================================== */

page {

  background: var(--theme-background);

  color: var(--theme-text);

  box-sizing: border-box;


  /* =====================================================
     Design Tokens — 通用（不随主题变化）
  ===================================================== */

  /* 圆角 */
  --radius-lg: 28rpx;
  --radius-md: 24rpx;
  --radius-sm: 16rpx;
  --radius-pill: 999rpx;

  /* 间距 */
  --space-page: 32rpx;
  --space-section: 36rpx;
  --space-card: 18rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 20rpx;
  --space-xl: 24rpx;

  /* 字号 */
  --font-display: 44rpx;
  --font-title: 34rpx;
  --font-section: 30rpx;
  --font-card: 26rpx;
  --font-body: 26rpx;
  --font-secondary: 22rpx;
  --font-caption: 20rpx;

  /* 图标尺寸 */
  --icon-sm: 44rpx;
  --icon-md: 64rpx;
  --icon-lg: 80rpx;

}


view,
text,
button,
input,
textarea,
picker,
scroll-view,
swiper,
swiper-item {

  box-sizing: border-box;

}


/* =====================================================
   模式1：经典紫色
===================================================== */

.theme-1 {

  --theme-main: #765B91;

  --theme-main-light: #EEE9F4;

  --theme-main-soft: #F4F1F7;

  --theme-background: #F7F5FA;

  --theme-text: #35313D;

  --theme-subtext: #8D8798;

  --theme-border: #E9E4EF;

  --theme-white: #FFFFFF;

  --theme-white-soft: rgba(255,255,255,0.78);

  --theme-white-faint: rgba(255,255,255,0.16);

  --theme-card: #FFFFFF;

  --theme-tabbar: rgba(255,255,255,0.97);

  --theme-other-month: #C9C3CF;

  --theme-shadow-main: rgba(118,91,145,0.22);

  --theme-shadow-card: rgba(45,32,70,0.06);

  --theme-shadow-tabbar: rgba(45,34,60,0.10);

  --theme-success: #6F9B7A;

  --theme-warning: #C49A5A;

  --theme-danger: #B96B73;

  --theme-gradient: linear-gradient(135deg, #765B91 0%, #806A9A 52%, #9180A8 100%);

  --theme-muted: #A29AA9;

  --theme-placeholder: #B4ADBB;

}


/* =====================================================
   模式2：柔和蓝紫
===================================================== */

.theme-2 {

  --theme-main: #7D86C9;

  --theme-main-light: #EEF0FA;

  --theme-main-soft: #F3F4F9;

  --theme-background: #F6F7FB;

  --theme-text: #343844;

  --theme-subtext: #858B9D;

  --theme-border: #E5E8F0;

  --theme-white: #FFFFFF;

  --theme-white-soft: rgba(255,255,255,0.78);

  --theme-white-faint: rgba(255,255,255,0.16);

  --theme-card: #FFFFFF;

  --theme-tabbar: rgba(255,255,255,0.97);

  --theme-other-month: #C4C8D4;

  --theme-shadow-main: rgba(125,134,201,0.22);

  --theme-shadow-card: rgba(52,56,68,0.06);

  --theme-shadow-tabbar: rgba(52,56,68,0.10);

  --theme-success: #6F9582;

  --theme-warning: #B99A62;

  --theme-danger: #B66F78;

  --theme-gradient: linear-gradient(135deg, #7D86C9 0%, #8885C4 52%, #9A8FC7 100%);

  --theme-muted: #A1A5B4;

  --theme-placeholder: #A6ABB8;

}


/* =====================================================
   全局容器
===================================================== */

.container {

  height: 100%;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: space-between;

  padding: 200rpx 0;

  box-sizing: border-box;

}


/* =====================================================
   通用主题组件
===================================================== */

.theme-card {

  background: var(--theme-card);

  border: 1rpx solid var(--theme-border);

  border-radius: 24rpx;

}


.theme-button {

  background: var(--theme-main);

  color: var(--theme-white);

  border: none;

}


.theme-button-light {

  background: var(--theme-main-light);

  color: var(--theme-main);

  border: none;

}


.theme-text-main {

  color: var(--theme-main);

}


.theme-text {

  color: var(--theme-text);

}


.theme-subtext {

  color: var(--theme-subtext);

}


.theme-border {

  border-color: var(--theme-border);

}


.theme-background-light {

  background: var(--theme-main-light);

}


.theme-background-soft {

  background: var(--theme-main-soft);

}


/* =====================================================
   通用进度条档位（class-based，替代 inline width）
===================================================== */

.progress-0 { width: 0%; }
.progress-1 { width: 10%; }
.progress-2 { width: 20%; }
.progress-3 { width: 30%; }
.progress-4 { width: 40%; }
.progress-5 { width: 50%; }
.progress-6 { width: 60%; }
.progress-7 { width: 70%; }
.progress-8 { width: 80%; }
.progress-9 { width: 90%; }
.progress-10 { width: 100%; }


/* =====================================================
   Icon System — CSS mask + 内联 SVG
   统一规范：24×24 / stroke 1.5 / 线性 / 圆角端点
   颜色通过 background-color: currentColor 由外层控制，
   Theme 1 / Theme 2 自动适配，SVG 内部不写死颜色。
===================================================== */

.icon {
  display: inline-block;
  flex-shrink: 0;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
}

