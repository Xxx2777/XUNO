===================================================== */

.setting-icon .icon,
.history-entry-icon .icon,
.add-target-icon .icon,
.tip-icon .icon,
.empty-icon .icon,
.search-icon .icon,
.period-icon .icon,
.action-icon .icon,
.status-option-icon .icon,
.leave-info-icon .icon,
.repeat-icon .icon,
.empty-note-icon .icon,
.homework-empty-icon .icon {
  width: 32rpx;
  height: 32rpx;
}


/* 导航 / 展开箭头 icon 尺寸 */
.menu-arrow .icon,
.next-arrow .icon,
.feedback-arrow .icon,
.setting-arrow .icon,
.recent-arrow .icon,
.project-arrow .icon,
.history-entry-arrow .icon,
.action-arrow .icon,
.header-tag-arrow .icon,
.more-arrow .icon {
  width: 32rpx;
  height: 32rpx;
}


/* 关闭 / 选中勾 icon 尺寸 */
.search-clear .icon,
.option-clear .icon,
.clear-button .icon,
.status-selected .icon {
  width: 28rpx;
  height: 28rpx;
}


